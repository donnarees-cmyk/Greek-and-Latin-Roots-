<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Greek &amp; Latin Roots Master Challenge - Differentiated - 6th Grade</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#172554;--bg:#eaf1fb;--card:#fff;--line:#c9d6ea;--teal:#0d9488;--sun:#facc15;--bad:#dc2626;--good:#16a34a;
--l0:#16a34a;--l1:#d97706;--l2:#7c3aed;--lv:var(--l0)}
*{box-sizing:border-box}
body{margin:0;font-family:Lexend,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5}
.wrap{max-width:900px;margin:0 auto;padding:20px 14px 40px}
header{background:var(--ink);color:#fff;border-radius:16px;padding:22px;margin-bottom:16px}
header h1{margin:0 0 4px;font-size:clamp(1.4rem,4vw,2rem)}
header p{margin:0;opacity:.85;font-size:.9rem}
button{font:inherit;cursor:pointer;color:inherit}
button:focus-visible{outline:3px solid var(--sun);outline-offset:2px}
.levels,.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.lvl{flex:1 1 180px;text-align:left;border:2px solid var(--line);background:var(--card);border-radius:12px;padding:10px 14px}
.lvl b{display:block}.lvl small{opacity:.75}
.lvl.on{border-color:var(--c);background:var(--c);color:#fff}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px}
.stat{background:var(--card);border-radius:12px;padding:10px;text-align:center;border:1px solid var(--line)}
.stat span{display:block;font-size:.75rem;opacity:.7}.stat b{font-size:1.4rem}
.tab{flex:1 1 130px;border:2px solid var(--line);background:var(--card);border-radius:999px;padding:8px 12px}
.tab.on{background:var(--teal);border-color:var(--teal);color:#fff}
section{display:none;background:var(--card);border-radius:16px;padding:20px;border:1px solid var(--line)}
section.on{display:block}
h2{margin-top:0}h3{margin:.4em 0}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:560px;margin-bottom:20px;font-size:.92rem}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line)}
th{background:var(--bg)}
.badge{display:inline-block;padding:2px 10px;border-radius:999px;color:#fff;font-size:.8rem}
.b0{background:var(--l0)}.b1{background:var(--l1)}.b2{background:var(--l2)}
.fc{perspective:900px;height:260px;margin:14px 0;cursor:pointer}
.fc-in{position:relative;width:100%;height:100%;transition:transform .5s;transform-style:preserve-3d}
.fc.flip .fc-in{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:16px;background:var(--ink);color:#fff}
.face.back{transform:rotateY(180deg);background:var(--teal)}
.face h2{font-size:2.4rem;margin:6px 0}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.btn{background:var(--ink);color:#fff;border:0;border-radius:10px;padding:10px 18px;margin-top:12px}
.btn.alt{background:var(--card);color:var(--ink);border:2px solid var(--ink)}
.bar{height:10px;background:var(--bg);border-radius:99px;overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;background:var(--teal)}
.meta{opacity:.7;font-size:.85rem;margin:0}
.ctx{background:var(--bg);border-left:5px solid var(--teal);padding:12px;border-radius:8px}
.link{background:none;border:0;text-decoration:underline;padding:0;color:var(--teal)}
.hint,.exp{background:#fef9c3;border-radius:8px;padding:10px;margin:8px 0}
.exp.ok{background:#dcfce7}.exp.no{background:#fee2e2}
.opts{display:grid;gap:8px;margin:12px 0}
.opt{text-align:left;background:var(--card);border:2px solid var(--line);border-radius:10px;padding:12px}
.opt:hover:not(:disabled){border-color:var(--teal)}
.opt.ok{background:#dcfce7;border-color:var(--good)}.opt.no{background:#fee2e2;border-color:var(--bad)}
.build{min-height:64px;border:2px dashed var(--teal);border-radius:12px;padding:10px;font-size:1.5rem;font-weight:700;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.part{background:var(--sun);border:0;border-radius:8px;padding:8px 14px;font-weight:700;margin:4px}
.part:disabled{opacity:.35;cursor:default}
.done{text-align:center;padding:20px}
@media(max-width:560px){.stats{grid-template-columns:repeat(2,1fr)}}
@media(prefers-reduced-motion:reduce){.fc-in{transition:none}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>Greek &amp; Latin Roots Master Challenge</h1>
  <p>Differentiated practice for 6th grade ELA. Standard ELA.6.V.1.2: Apply knowledge of Greek and Latin roots and affixes.</p>
</header>

<div class="levels" id="levels"></div>
<div class="stats">
  <div class="stat"><span>Total score</span><b id="s-score">0</b></div>
  <div class="stat"><span>Current level</span><b id="s-level">Beginner</b></div>
  <div class="stat"><span>Correct answers</span><b id="s-correct">0</b></div>
  <div class="stat"><span>Streak</span><b id="s-streak">0</b></div>
</div>

<div class="tabs" id="tabs"></div>

<section id="ref"></section>

<section id="cards">
  <h2>Flashcards</h2>
  <p>Click the card to flip it and see the meaning.</p>
  <div class="fc" id="fc" tabindex="0" role="button" aria-label="Flip card">
    <div class="fc-in">
      <div class="face"><span class="badge" id="fc-badge"></span><h2 id="fc-root"></h2><p>Click to reveal meaning</p></div>
      <div class="face back"><h2 id="fc-mean"></h2><p id="fc-ex"></p><p id="fc-tip"></p></div>
    </div>
  </div>
  <div class="bar"><i id="fc-bar"></i></div>
  <p class="meta" id="fc-count"></p>
  <div class="row">
    <button class="btn alt" id="fc-prev">Previous</button>
    <button class="btn" id="fc-next">Next</button>
    <button class="btn alt" id="fc-shuf">Shuffle</button>
  </div>
</section>

<section id="quiz"><h2>Practice quiz</h2><p>Questions change with your selected level.</p><div id="quiz-box"></div></section>

<section id="build">
  <h2>Word builder</h2>
  <p>Click word parts in order to build the word.</p>
  <div id="build-box"></div>
</section>

<section id="context"><h2>Context practice</h2><p>Use the sentence and the word parts to figure out each meaning.</p><div id="ctx-box"></div></section>
</div>

<script>
/* ============ EDIT YOUR CONTENT HERE ============
   Roots: l = level (0 beginner, 1 intermediate, 2 advanced)
   Words: p = word parts in order, m = meaning, s = sentence (**word** is bolded), l = level */
const R=[
{r:'bio',m:'life',o:'Greek',x:'biology, biography, biodegradable',t:'"biology" = study of life',l:0},
{r:'geo',m:'earth',o:'Greek',x:'geology, geography, geometry',t:'"geography" = study of Earth',l:0},
{r:'graph/gram',m:'write, writing',o:'Greek',x:'autograph, telegram, paragraph',t:'"autograph" = self-writing (signature)',l:0},
{r:'phon',m:'sound',o:'Greek',x:'telephone, phonics, symphony',t:'"telephone" = far sound',l:0},
{r:'photo',m:'light',o:'Greek',x:'photograph, photosynthesis',t:'"photograph" = writing with light',l:0},
{r:'tele',m:'far, distant',o:'Greek',x:'television, telescope, telephone',t:'"television" = seeing from far away',l:0},
{r:'aud',m:'hear',o:'Latin',x:'audience, audible, auditorium',t:'"audience" = people who hear',l:0},
{r:'dict',m:'say, speak',o:'Latin',x:'dictate, predict, dictionary',t:'"dictate" = tell what to say',l:0},
{r:'port',m:'carry',o:'Latin',x:'transport, portable, export',t:'"transport" = carry across',l:0},
{r:'scrib/script',m:'write',o:'Latin',x:'scribble, manuscript, describe',t:'"scribble" = messy writing',l:0},
{r:'auto',m:'self',o:'Greek',x:'automobile, autobiography',t:'"automatic" = does it by itself',l:1},
{r:'micro',m:'small',o:'Greek',x:'microscope, microwave',t:'"microscope" = see small things',l:1},
{r:'scope',m:'watch, examine',o:'Greek',x:'telescope, microscope',t:'"telescope" = see far away',l:1},
{r:'hydro',m:'water',o:'Greek',x:'hydroelectric, hydrate',t:'"hydrate" = add water',l:1},
{r:'therm',m:'heat',o:'Greek',x:'thermometer, thermal',t:'"thermometer" = measure heat',l:1},
{r:'meter/metr',m:'measure',o:'Greek',x:'thermometer, perimeter',t:'"thermometer" = heat measurer',l:1},
{r:'vis/vid',m:'see',o:'Latin',x:'vision, video, visible',t:'"vision" = ability to see',l:1},
{r:'tract',m:'pull, drag',o:'Latin',x:'tractor, attract, extract',t:'"tractor" = pulls farm equipment',l:1},
{r:'rupt',m:'break',o:'Latin',x:'interrupt, erupt, disrupt',t:'"interrupt" = break into a conversation',l:2},
{r:'struct',m:'build',o:'Latin',x:'construct, structure, instruct',t:'"construct" = build something',l:2},
{r:'ject',m:'throw',o:'Latin',x:'eject, project, reject',t:'"eject" = throw out',l:2},
{r:'spect',m:'look',o:'Latin',x:'inspect, spectator, respect',t:'"spectator" = one who watches',l:2},
{r:'form',m:'shape',o:'Latin',x:'transform, uniform, reform',t:'"transform" = change shape',l:2},
{r:'miss/mit',m:'send',o:'Latin',x:'mission, transmit, dismiss',t:'"mission" = being sent to do something',l:2}
];
const W=[
{w:'biology',p:['bio','logy'],m:'the study of life',s:'In **biology** class, we studied how plants and animals grow.',l:0},
{w:'geography',p:['geo','graphy'],m:'the study of Earth\'s features',s:'In **geography**, Mia used a map to find the longest river in Florida.',l:0},
{w:'telephone',p:['tele','phone'],m:'a device that carries sound from far away',s:'Grandpa called us on the **telephone** from three states away.',l:0},
{w:'audible',p:['aud','ible'],m:'able to be heard',s:'The teacher\'s whisper was barely **audible** in the noisy room.',l:0},
{w:'transport',p:['trans','port'],m:'to carry across',s:'Buses **transport** students across town every morning.',l:0},
{w:'describe',p:['de','scribe'],m:'to write down the details of something',s:'Please **describe** the setting of the story in two sentences.',l:0},
{w:'autograph',p:['auto','graph'],m:'a person\'s own signature',s:'The author signed an **autograph** on my book.',l:1},
{w:'microscope',p:['micro','scope'],m:'a tool for seeing very small things',s:'The scientist used a **microscope** to examine tiny organisms.',l:1},
{w:'telescope',p:['tele','scope'],m:'a tool for seeing far away',s:'Using a **telescope**, we saw the rings of Saturn.',l:1},
{w:'thermometer',p:['therm','o','meter'],m:'a tool that measures heat',s:'The nurse checked my temperature with a **thermometer**.',l:1},
{w:'dehydrate',p:['de','hydr','ate'],m:'to remove water',s:'Hot sun can **dehydrate** you if you forget to drink water.',l:1},
{w:'invisible',p:['in','vis','ible'],m:'not able to be seen',s:'The ghost in the story was **invisible** to everyone but Sam.',l:1},
{w:'attract',p:['at','tract'],m:'to pull toward',s:'A magnet can **attract** paper clips.',l:1},
{w:'interrupt',p:['inter','rupt'],m:'to break into something',s:'Please do not **interrupt** while your classmate is speaking.',l:2},
{w:'reconstruct',p:['re','con','struct'],m:'to build again',s:'Workers will **reconstruct** the bridge after the storm.',l:2},
{w:'inspect',p:['in','spect'],m:'to look into something closely',s:'The mechanic will **inspect** the engine for leaks.',l:2},
{w:'transform',p:['trans','form'],m:'to change the shape of something',s:'A caterpillar will **transform** into a butterfly.',l:2},
{w:'transmit',p:['trans','mit'],m:'to send across',s:'Towers **transmit** radio signals across the state.',l:2},
{w:'project',p:['pro','ject'],m:'to throw forward',s:'The theater will **project** the film onto a large screen.',l:2}
];
/* ============ APP CODE ============ */
const LV=['Beginner','Intermediate','Advanced'],SUB=['Basic roots and meanings','Apply roots to words','Complex analysis'],PTS=[10,15,20];
const $=id=>document.getElementById(id);
const shuffle=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const cap=s=>s.charAt(0).toUpperCase()+s.slice(1);
const bold=s=>s.replace(/\*\*(.+?)\*\*/g,'<b>$1</b>');
let level=0,score=0,correct=0,streak=0,best=0;

function stat(ok){
  if(ok){score+=PTS[level];correct++;streak++;best=Math.max(best,streak)}else streak=0;
  $('s-score').textContent=score;$('s-correct').textContent=correct;$('s-streak').textContent=streak;
}

/* Levels */
const lvBox=$('levels'),cols=['--l0','--l1','--l2'],icons=['🌱','🌿','🌳'];
LV.forEach((n,i)=>{
  const b=document.createElement('button');b.className='lvl'+(i?'':' on');b.style.setProperty('--c',`var(${cols[i]})`);
  b.innerHTML=`<b>${icons[i]} ${n}</b><small>${SUB[i]}</small>`;
  b.onclick=()=>{level=i;document.querySelectorAll('.lvl').forEach((x,j)=>x.classList.toggle('on',j===i));
    document.documentElement.style.setProperty('--lv',`var(${cols[i]})`);$('s-level').textContent=LV[i];quizMC.start();ctxMC.start();loadBuild()};
  lvBox.appendChild(b);
});

/* Tabs */
[['ref','📚 Reference guide'],['cards','🎴 Flashcards'],['quiz','✍️ Practice quiz'],['build','🔨 Word builder'],['context','📖 Context practice']].forEach(([id,label],i)=>{
  const b=document.createElement('button');b.className='tab'+(i?'':' on');b.textContent=label;
  b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));b.classList.add('on');
    document.querySelectorAll('section').forEach(s=>s.classList.toggle('on',s.id===id))};
  $('tabs').appendChild(b);
});
$('ref').classList.add('on');

/* Reference */
const tbl=o=>`<h3>${o==='Greek'?'🏛️ Greek':'🏛️ Latin'} roots</h3><div class="scroll"><table><tr><th>Root</th><th>Meaning</th><th>Example words</th><th>Memory tip</th></tr>`+
  R.filter(r=>r.o===o).map(r=>`<tr><td><b>${r.r}</b></td><td>${r.m}</td><td>${r.x}</td><td>Think of ${r.t}</td></tr>`).join('')+'</table></div>';
$('ref').innerHTML='<h2>📚 Greek &amp; Latin roots reference guide</h2>'+tbl('Greek')+tbl('Latin');

/* Flashcards */
let deck=[...R],ci=0;
function card(){
  const c=deck[ci];$('fc').classList.remove('flip');
  $('fc-root').textContent=c.r;$('fc-mean').textContent=c.m;
  $('fc-ex').innerHTML=`<b>Examples:</b> ${c.x}`;$('fc-tip').textContent='💡 Think of '+c.t;
  $('fc-badge').textContent=LV[c.l];$('fc-badge').className='badge b'+c.l;
  $('fc-bar').style.width=((ci+1)/deck.length*100)+'%';$('fc-count').textContent=`${ci+1} / ${deck.length}`;
}
const flip=()=>$('fc').classList.toggle('flip');
$('fc').onclick=flip;$('fc').onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();flip()}};
$('fc-next').onclick=()=>{ci=(ci+1)%deck.length;card()};
$('fc-prev').onclick=()=>{ci=(ci-1+deck.length)%deck.length;card()};
$('fc-shuf').onclick=()=>{deck=shuffle(deck);ci=0;card()};
card();

/* Multiple-choice engine (used by quiz and context practice) */
function MC(boxId,make){
  const box=$(boxId);let qs=[],i=0,done=false;
  function start(){qs=make();i=0;show()}
  function show(){
    if(i>=qs.length){box.innerHTML=`<div class="done"><h3>🎉 Round complete!</h3><p>Total score: ${score}. Best streak: ${best}.</p><button class="btn" id="${boxId}-again">Start over</button></div>`;
      $(boxId+'-again').onclick=start;return}
    const x=qs[i];done=false;x.show=shuffle(x.o);
    box.innerHTML=`<p class="meta">Question ${i+1} of ${qs.length} (${LV[level]} level)</p>`+
      (x.c?`<p class="ctx">${bold(x.c)}</p>`:'')+`<h3>${x.q}</h3>
      <button class="link" id="${boxId}-h">Show hint</button><p class="hint" id="${boxId}-ht" hidden><b>Hint:</b> ${x.h}</p>
      <div class="opts">${x.show.map((o,k)=>`<button class="opt" data-k="${k}">${o}</button>`).join('')}</div>
      <div class="exp" id="${boxId}-e" hidden></div><button class="btn" id="${boxId}-n" hidden>Next question</button>`;
    $(boxId+'-h').onclick=()=>{$(boxId+'-ht').hidden=false};
    $(boxId+'-n').onclick=()=>{i++;show()};
    box.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{
      if(done)return;done=true;const ok=x.show[b.dataset.k]===x.a;stat(ok);
      box.querySelectorAll('.opt').forEach((o,k)=>{o.disabled=true;if(x.show[k]===x.a)o.classList.add('ok')});
      if(!ok)b.classList.add('no');
      const e=$(boxId+'-e');e.hidden=false;e.className='exp '+(ok?'ok':'no');
      e.innerHTML=(ok?'✓ Correct! ':'✗ Not quite. The answer is "'+x.a+'". ')+x.e;$(boxId+'-n').hidden=false});
  }
  return{start};
}
const words=l=>W.filter(w=>w.l===l);
const wordOpts=w=>[cap(w.m),...shuffle(W.filter(o=>o.w!==w.w)).slice(0,3).map(o=>cap(o.m))];
const sharesWord=(a,b)=>{const t=s=>s.split(/[ ,]+/);return t(a).some(x=>t(b).includes(x))};

const quizMC=MC('quiz-box',()=>{
  const rq=R.filter(r=>r.l===level).map(r=>({
    q:`What does the root "${r.r}" mean?`,h:`Think about the word ${r.t.split(' = ')[0]}.`,a:r.m,
    o:[r.m,...shuffle(R.filter(o=>!sharesWord(o.m,r.m))).slice(0,3).map(o=>o.m)],
    e:`"${r.r}" is a ${r.o} root meaning "${r.m}". Examples: ${r.x}.`}));
  const wq=words(level).map(w=>({
    q:`What does the word "${w.w}" mean?`,h:`Break it apart: ${w.p.join(' + ')}.`,a:cap(w.m),o:wordOpts(w),
    e:`${w.w} = ${w.p.join(' + ')}, which means "${w.m}".`}));
  return shuffle([...rq,...wq]).slice(0,10);
});
const ctxMC=MC('ctx-box',()=>shuffle(words(level)).slice(0,10).map(w=>({
  c:w.s,q:`Based on its parts (${w.p.join(' + ')}), what does "${w.w}" mean?`,
  h:'Look at the sentence for clues, then break the word into parts.',a:cap(w.m),o:wordOpts(w),
  e:`${w.w} = ${w.p.join(' + ')}, which means "${w.m}".`})));

/* Word builder */
const allParts=[...new Set(W.flatMap(w=>w.p))];
let bq=[],bi=0,chosen=[],scored=false;
function loadBuild(){bq=shuffle(words(level)).slice(0,10);bi=0;buildShow()}
function buildShow(){
  const box=$('build-box');
  if(bi>=bq.length){box.innerHTML=`<div class="done"><h3>🎉 All words built!</h3><p>Total score: ${score}.</p><button class="btn" id="b-again">Start over</button></div>`;$('b-again').onclick=loadBuild;return}
  const w=bq[bi];chosen=[];scored=false;
  const parts=shuffle([...w.p,...shuffle(allParts.filter(p=>!w.p.includes(p))).slice(0,3)]);
  box.innerHTML=`<p class="meta">Challenge ${bi+1} of ${bq.length} (${LV[level]} level)</p>
    <h3>Build a word that means: "${w.m}"</h3>
    <button class="link" id="b-h">Show hint</button><p class="hint" id="b-ht" hidden><b>Hint:</b> The word starts with "${w.p[0]}" and has ${w.p.length} parts.</p>
    <div class="build" id="b-out" aria-live="polite">Click parts below</div>
    <p><b>Available parts:</b></p><div id="b-parts">${parts.map((p,k)=>`<button class="part" data-k="${k}">${p}</button>`).join('')}</div>
    <div class="row"><button class="btn" id="b-check">✓ Check answer</button><button class="btn alt" id="b-clear">✗ Clear</button><button class="btn alt" id="b-skip">Skip</button></div>
    <div class="exp" id="b-e" hidden></div><button class="btn" id="b-next" hidden>Next word</button>`;
  $('b-h').onclick=()=>{$('b-ht').hidden=false};
  const draw=()=>{$('b-out').textContent=chosen.length?chosen.join(''):'Click parts below'};
  document.querySelectorAll('.part').forEach(b=>b.onclick=()=>{chosen.push(b.textContent);b.disabled=true;draw()});
  $('b-clear').onclick=()=>{chosen=[];document.querySelectorAll('.part').forEach(b=>b.disabled=false);draw()};
  $('b-skip').onclick=()=>{bi++;buildShow()};$('b-next').onclick=()=>{bi++;buildShow()};
  $('b-check').onclick=()=>{
    if(!chosen.length||scored)return;
    const ok=chosen.join('')===w.w,e=$('b-e');e.hidden=false;e.className='exp '+(ok?'ok':'no');
    if(ok){scored=true;stat(true);e.innerHTML=`✓ Correct! <b>${w.w}</b> = ${w.p.join(' + ')}, which means "${w.m}".`;
      $('b-next').hidden=false;document.querySelectorAll('.part').forEach(b=>b.disabled=true)}
    else{stat(false);e.textContent='✗ Not quite. Click Clear and try a different order or different parts.'}
  };
}

quizMC.start();ctxMC.start();loadBuild();
</script>
</body>
</html>
